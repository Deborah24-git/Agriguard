# Mongo connection. Use a dedicated database name so the app never touches
# another project's collections on a shared cluster.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/agriguard?retryWrites=true&w=majority

# NextAuth v5. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me
AUTH_TRUST_HOST=true

# Shared key field hardware sends as the x-api-key header to /api/ingest
INGEST_API_KEY=replace-me

# Africa's Talking SMS. Put real credentials in .env.local, never in this sample.


# Optional recipient override; otherwise the farmer's saved phone number is used.
AT_SMS_TO=

# Password given to the two demo accounts created by `npm run seed`
SEED_DEMO_PASSWORD=password123
